# ─────────────────────────────────────────────────────────────────────────────
#  GeoShare — configuration
#  Copy this file to ".env" and fill in your own values.
#  `.env` is git-ignored. Expo loads it automatically (dev, build & EAS).
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase Web SDK config ──────────────────────────────────────────────────
# Firebase Console → Project Settings → "Your apps" → Web app → SDK config.
# These are PUBLIC client identifiers (not secrets); security is enforced by
# database.rules.json. The EXPO_PUBLIC_ prefix makes them available at runtime.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ── Map ──────────────────────────────────────────────────────────────────────
# None needed! The map uses OpenStreetMap (Leaflet in a WebView) — no API key,
# no Google Cloud account, works in Expo Go.

# ── EAS / Expo (only needed for cloud builds & push notifications) ───────────
# Created automatically by `eas init`; copy the projectId here afterwards.
EAS_PROJECT_ID=
